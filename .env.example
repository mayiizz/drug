# Copy to .env and fill in values. Never commit .env.

# Groq (research agent + GraphRAG synthesis)
GROQ_API_KEY=

# Neo4j Aura (knowledge graph + GraphRAG retrieval)
# Create a free instance at https://console.neo4j.io
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Optional frontend override when API is not on :8000
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8002
